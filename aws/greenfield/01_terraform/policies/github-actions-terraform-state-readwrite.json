{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadKa1OidcProvider",
            "Effect": "Allow",
            "Action": "iam:GetOpenIDConnectProvider",
            "Resource": "arn:aws:iam::891920435804:oidc-provider/raw.githubusercontent.com/MichelBrodatzki/brodatzki.net/main/.static/ka1"
        },
        {
            "Sid": "ManageBoundedKa1SecretsRole",
            "Effect": "Allow",
            "Action": [
                "iam:GetRole",
                "iam:UpdateRole",
                "iam:TagRole",
                "iam:UntagRole",
                "iam:ListRoleTags",
                "iam:GetRolePolicy",
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:ListAttachedRolePolicies",
                "iam:ListRolePolicies",
                "iam:UpdateAssumeRolePolicy"
            ],
            "Resource": "arn:aws:iam::891920435804:role/ka1-k8s-secrets-readonly"
        },
        {
            "Sid": "CreateKa1SecretsRoleWithBoundary",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:PutRolePermissionsBoundary"
            ],
            "Resource": "arn:aws:iam::891920435804:role/ka1-k8s-secrets-readonly",
            "Condition": {
                "ArnEquals": {
                    "iam:PermissionsBoundary": "arn:aws:iam::891920435804:policy/terraform-boundary-ka1-k8s-secrets-readonly"
                }
            }
        },
        {
            "Sid": "CleanUpLegacyKa1ManagedPolicyAttachment",
            "Effect": "Allow",
            "Action": "iam:DetachRolePolicy",
            "Resource": "arn:aws:iam::891920435804:role/ka1-k8s-secrets-readonly",
            "Condition": {
                "ArnEquals": {
                    "iam:PolicyARN": "arn:aws:iam::891920435804:policy/ka1-parameters-readonly-access"
                }
            }
        },
        {
            "Sid": "CleanUpLegacyKa1ManagedPolicy",
            "Effect": "Allow",
            "Action": [
                "iam:GetPolicy",
                "iam:GetPolicyVersion",
                "iam:ListPolicyVersions",
                "iam:ListPolicyTags",
                "iam:ListEntitiesForPolicy",
                "iam:DeletePolicyVersion",
                "iam:DeletePolicy"
            ],
            "Resource": "arn:aws:iam::891920435804:policy/ka1-parameters-readonly-access"
        },
        {
            "Sid": "DenyUnboundedKa1SecretsRole",
            "Effect": "Deny",
            "Action": [
                "iam:CreateRole",
                "iam:PutRolePermissionsBoundary"
            ],
            "Resource": "arn:aws:iam::891920435804:role/ka1-k8s-secrets-readonly",
            "Condition": {
                "ArnNotEquals": {
                    "iam:PermissionsBoundary": "arn:aws:iam::891920435804:policy/terraform-boundary-ka1-k8s-secrets-readonly"
                }
            }
        },
        {
            "Sid": "ManageRolesAnywhereServiceLinkedRole",
            "Effect": "Allow",
            "Action": "iam:CreateServiceLinkedRole",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "iam:AWSServiceName": "rolesanywhere.amazonaws.com"
                }
            }
        },
        {
            "Sid": "CreateTaggedBackupTrustAnchor",
            "Effect": "Allow",
            "Action": "rolesanywhere:CreateTrustAnchor",
            "Resource": "arn:aws:rolesanywhere:eu-central-1:891920435804:trust-anchor/*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/project": "backups"
                }
            }
        },
        {
            "Sid": "ManageTaggedBackupTrustAnchors",
            "Effect": "Allow",
            "Action": [
                "rolesanywhere:GetTrustAnchor",
                "rolesanywhere:UpdateTrustAnchor",
                "rolesanywhere:DeleteTrustAnchor",
                "rolesanywhere:EnableTrustAnchor",
                "rolesanywhere:DisableTrustAnchor",
                "rolesanywhere:TagResource",
                "rolesanywhere:ListTagsForResource"
            ],
            "Resource": "arn:aws:rolesanywhere:eu-central-1:891920435804:trust-anchor/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/project": "backups"
                }
            }
        },
        {
            "Sid": "CreateTaggedBackupProfile",
            "Effect": "Allow",
            "Action": "rolesanywhere:CreateProfile",
            "Resource": "arn:aws:rolesanywhere:eu-central-1:891920435804:profile/*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/project": "backups"
                }
            }
        },
        {
            "Sid": "ManageTaggedBackupProfiles",
            "Effect": "Allow",
            "Action": [
                "rolesanywhere:GetProfile",
                "rolesanywhere:UpdateProfile",
                "rolesanywhere:DeleteProfile",
                "rolesanywhere:EnableProfile",
                "rolesanywhere:DisableProfile",
                "rolesanywhere:TagResource",
                "rolesanywhere:ListTagsForResource"
            ],
            "Resource": "arn:aws:rolesanywhere:eu-central-1:891920435804:profile/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/project": "backups"
                }
            }
        },
        {
            "Sid": "ManageBoundedBackupRole",
            "Effect": "Allow",
            "Action": [
                "iam:GetRole",
                "iam:UpdateRole",
                "iam:TagRole",
                "iam:UntagRole",
                "iam:ListRoleTags",
                "iam:GetRolePolicy",
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:ListAttachedRolePolicies",
                "iam:ListRolePolicies"
            ],
            "Resource": "arn:aws:iam::891920435804:role/vps1-netcup-brodatzki-network-backup"
        },
        {
            "Sid": "CreateBackupRoleWithBoundary",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:PutRolePermissionsBoundary"
            ],
            "Resource": "arn:aws:iam::891920435804:role/vps1-netcup-brodatzki-network-backup",
            "Condition": {
                "ArnEquals": {
                    "iam:PermissionsBoundary": "arn:aws:iam::891920435804:policy/terraform-boundary-vps1-netcup-brodatzki-network-backup"
                }
            }
        },
        {
            "Sid": "DenyUnboundedBackupRole",
            "Effect": "Deny",
            "Action": [
                "iam:CreateRole",
                "iam:PutRolePermissionsBoundary"
            ],
            "Resource": "arn:aws:iam::891920435804:role/vps1-netcup-brodatzki-network-backup",
            "Condition": {
                "ArnNotEquals": {
                    "iam:PermissionsBoundary": "arn:aws:iam::891920435804:policy/terraform-boundary-vps1-netcup-brodatzki-network-backup"
                }
            }
        },
        {
            "Sid": "PassBackupRoleToRolesAnywhereOnly",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::891920435804:role/vps1-netcup-brodatzki-network-backup",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "rolesanywhere.amazonaws.com"
                }
            }
        },
        {
            "Sid": "DenyBoundaryRemovalRoleDeletionAndManagedPolicyAttachment",
            "Effect": "Deny",
            "Action": [
                "iam:DeleteRolePermissionsBoundary",
                "iam:DeleteRole",
                "iam:AttachRolePolicy"
            ],
            "Resource": [
                "arn:aws:iam::891920435804:role/ka1-k8s-secrets-readonly",
                "arn:aws:iam::891920435804:role/vps1-netcup-brodatzki-network-backup"
            ]
        },
        {
            "Sid": "DenyBackupRoleTrustPolicyChanges",
            "Effect": "Deny",
            "Action": "iam:UpdateAssumeRolePolicy",
            "Resource": "arn:aws:iam::891920435804:role/vps1-netcup-brodatzki-network-backup"
        },
        {
            "Sid": "ManageBackupBucket",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket",
                "s3:DeleteBucket",
                "s3:ListBucket",
                "s3:Get*",
                "s3:Put*"
            ],
            "Resource": "arn:aws:s3:::backups-brodatzkinet-891920435804"
        }
    ]
}
