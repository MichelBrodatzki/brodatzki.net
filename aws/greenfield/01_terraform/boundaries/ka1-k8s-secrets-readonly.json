{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadKa1ParametersOnly",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter",
                "ssm:GetParameters",
                "ssm:GetParametersByPath"
            ],
            "Resource": "arn:aws:ssm:eu-central-1:891920435804:parameter/ka1/*"
        },
        {
            "Sid": "DecryptKa1ParametersOnly",
            "Effect": "Allow",
            "Action": "kms:Decrypt",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "kms:CallerAccount": "891920435804",
                    "kms:ViaService": "ssm.eu-central-1.amazonaws.com"
                },
                "StringLike": {
                    "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:eu-central-1:891920435804:parameter/ka1/*"
                }
            }
        }
    ]
}
